# ── Ultimate Group Manager — Environment Template ──
# Copy this file to .env and fill your values:  cp .env.example .env

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:AAHyour_bot_token_here

# Bot owner username (without @) — gets owner privileges in all groups
OWNER_USERNAME=your_username

# Optional: Support channel username (without @) — shown in /start
SUPPORT_CHANNEL=

# Optional: PostgreSQL URL (Neon). Leave empty to use local SQLite (manager.db)
DATABASE_URL=

# Optional: Admin dashboard password (leave empty for open access)
# If set, dashboard will require login at /login
ADMIN_PASSWORD=
# Alias: DASHBOARD_PASSWORD is also accepted
# DASHBOARD_PASSWORD=

# Optional: Public URL for leaderboard website buttons (Telegram "View on Website")
# Example: https://your-app.onrender.com  (no trailing slash)
# When set, "View complete leaderboard" will show a "View on Website" button
PUBLIC_URL=
# Also accepts: LEADERBOARD_URL or RENDER_EXTERNAL_URL

# ── Chat Activity / Rankings ──
# Master switch (1 = on, 0 = off)
CHAT_ACTIVITY_ENABLED=1
# Timezone for daily/weekly leaderboards (IANA)
CHAT_ACTIVITY_TIMEZONE=Asia/Dhaka

# Ranking Anti-Spam: max msgs / window sec -> cooldown sec
# Dashboard can override these live (Settings → Ranking Anti-Spam)
RANK_SPAM_MAX=4
RANK_SPAM_WINDOW=4.0
RANK_SPAM_COOLDOWN=600

# ── Server ──
PORT=8000
